{
  "name": "argos-intel",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "build": "pnpm --dir apps/web-desktop build",
    "check:web-build": "node scripts/check_web_build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages --max-warnings=0",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^25.0.0",
    "msw": "^2.0.0",
    "prettier": "3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.0"
  }
}
