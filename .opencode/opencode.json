{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.8-flash",
  "small_model": "google/gemini-3.5-flash-lite",
  "default_agent": "plan",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "google/gemini-3.1-pro-preview-custom-tools",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "google/gemini-3.1-pro-preview",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "google/gemini-3.5-flash-lite",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "compaction": {
      "mode": "primary",
      "model": "google/gemini-3.8-flash"
    }
  }
}
