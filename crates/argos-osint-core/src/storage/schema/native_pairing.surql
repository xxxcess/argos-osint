DEFINE TABLE IF NOT EXISTS native_pairing SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS pairing_id ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS installation_hash ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS proof_hash ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS approval_code ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS expires_at_ms ON native_pairing TYPE int;
DEFINE FIELD IF NOT EXISTS state ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS credential_id ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS issuance_nonce ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS issuer_id ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS scope_id ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS access_epoch ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS permissions_json ON native_pairing TYPE string;
DEFINE FIELD IF NOT EXISTS token_hash ON native_pairing TYPE string;
DEFINE INDEX IF NOT EXISTS native_pairing_token ON native_pairing FIELDS token_hash;
DEFINE INDEX IF NOT EXISTS native_pairing_credential ON native_pairing FIELDS credential_id;
DEFINE INDEX IF NOT EXISTS native_pairing_pending ON native_pairing FIELDS state,expires_at_ms;
DEFINE TABLE IF NOT EXISTS native_pairing_rate SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS started_at_ms ON native_pairing_rate TYPE int;
DEFINE FIELD IF NOT EXISTS attempts ON native_pairing_rate TYPE int;
