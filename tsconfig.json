{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@argos/ui": [
        "./packages/ui/src"
      ],
      "@argos/intel": [
        "./packages/intel/src"
      ],
      "@argos/api-client": [
        "./packages/api-client/src"
      ]
    }
  },
  "include": [
    "apps/**/*.tsx",
    "packages/**/*.tsx",
    "tests/web/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
