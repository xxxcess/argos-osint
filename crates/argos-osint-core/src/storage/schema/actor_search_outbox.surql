-- Actor discovery intent joins canonical source transactions. Search remains derived.
DEFINE TABLE IF NOT EXISTS actor_search_control SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS revision ON actor_search_control TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS next_sequence ON actor_search_control TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS acknowledged_sequence ON actor_search_control TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS deployment_id ON actor_search_control TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS source_epoch ON actor_search_control TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS index_generation ON actor_search_control TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS lease_owner ON actor_search_control TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS lease_epoch ON actor_search_control TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS lease_until ON actor_search_control TYPE datetime DEFAULT <datetime>'1970-01-01T00:00:00Z';
DEFINE FIELD IF NOT EXISTS next_start_at ON actor_search_control TYPE datetime DEFAULT <datetime>'1970-01-01T00:00:00Z';
DEFINE FIELD IF NOT EXISTS retry_at ON actor_search_control TYPE datetime DEFAULT <datetime>'1970-01-01T00:00:00Z';
DEFINE FIELD IF NOT EXISTS failures ON actor_search_control TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS last_error ON actor_search_control TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS blocked ON actor_search_control TYPE bool DEFAULT false;
DEFINE FIELD IF NOT EXISTS pending_json ON actor_search_control TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS backfill_after ON actor_search_control TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS backfill_complete ON actor_search_control TYPE bool DEFAULT false;
DEFINE TABLE IF NOT EXISTS actor_search_head SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS actor_id ON actor_search_head TYPE string;
DEFINE FIELD IF NOT EXISTS revision ON actor_search_head TYPE int;
DEFINE FIELD IF NOT EXISTS updated_at ON actor_search_head TYPE datetime;
DEFINE TABLE IF NOT EXISTS actor_search_event SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS sequence ON actor_search_event TYPE int;
DEFINE FIELD IF NOT EXISTS actor_id ON actor_search_event TYPE string;
DEFINE FIELD IF NOT EXISTS revision ON actor_search_event TYPE int;
DEFINE FIELD IF NOT EXISTS cause_job ON actor_search_event TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created_at ON actor_search_event TYPE datetime;
DEFINE INDEX IF NOT EXISTS actor_search_event_sequence ON actor_search_event FIELDS sequence UNIQUE;
DEFINE INDEX IF NOT EXISTS actor_search_event_cause ON actor_search_event FIELDS cause_job, sequence;
DEFINE INDEX IF NOT EXISTS actor_search_alias_owner ON brain_actor_alias FIELDS actor_id, alias_type, alias;
DEFINE TABLE IF NOT EXISTS actor_search_cause SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS parent_job ON actor_search_cause TYPE string;
DEFINE FIELD IF NOT EXISTS operation_id ON actor_search_cause TYPE string;
DEFINE FIELD IF NOT EXISTS required_sequence ON actor_search_cause TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS total_events ON actor_search_cause TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS acknowledged_events ON actor_search_cause TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS closed ON actor_search_cause TYPE bool DEFAULT false;
DEFINE FIELD IF NOT EXISTS partial_source ON actor_search_cause TYPE bool DEFAULT false;
DEFINE FIELD IF NOT EXISTS done ON actor_search_cause TYPE bool DEFAULT false;
DEFINE INDEX IF NOT EXISTS actor_search_cause_finish ON actor_search_cause FIELDS done, closed, required_sequence;
