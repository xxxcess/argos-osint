{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "plan",

  "agents": {
    "plan": {
      "mode": "primary",
      "model": "opencode/nemotron-3-ultra-free"
    },

    "build": {
      "mode": "all",
      "description": "Implements an approved plan in a child session and reports changes and checks",
      "model": "openrouter/cohere/north-mini-code:free"
    },

    "explore": {
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free"
    },

    "general": {
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free"
    }
  }
}
