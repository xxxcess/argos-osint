FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates dbus-daemon fontconfig fonts-dejavu-core libdbus-1-3 \
        libgcc-s1 libstdc++6 libvulkan1 libwayland-client0 libwayland-cursor0 libwayland-egl1 \
        libx11-6 libx11-xcb1 libxcb-render0 libxcb-shape0 libxcb-xfixes0 libxcb1 \
        libxcursor1 libxi6 libxkbcommon-x11-0 libxkbcommon0 libxrandr2 mesa-vulkan-drivers \
        procps python3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 fleetworks \
    && useradd --uid 10001 --gid 10001 --home-dir /home/fleetworks --no-create-home fleetworks \
    && install -d -m 0700 -o 10001 -g 10001 /home/fleetworks /run/user/10001

ARG NATIVE_REVISION
ARG NATIVE_VERSION
ARG NATIVE_PROFILE
ARG NATIVE_ARCHIVE_SHA256
LABEL org.opencontainers.image.title="Fleetworks Native Embedded development" \
      org.opencontainers.image.revision="${NATIVE_REVISION}" \
      org.opencontainers.image.version="${NATIVE_VERSION}" \
      org.fleetworks.native.profile="${NATIVE_PROFILE}" \
      org.fleetworks.native.archive-sha256="${NATIVE_ARCHIVE_SHA256}"

COPY Fleetworks-linux-x86_64/ /opt/fleetworks/

ENV HOME=/home/fleetworks XDG_RUNTIME_DIR=/run/user/10001
WORKDIR /home/fleetworks
USER 10001:10001
ENTRYPOINT ["/opt/fleetworks/bin/fleetworks-desktop"]
