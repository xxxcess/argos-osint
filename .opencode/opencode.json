{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/nemotron-3-super-120b-a12b:free",
  "small_model": "openrouter/north-mini-code:free",
  "default_agent": "plan",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openrouter/nemotron-3-super-120b-a12b:free",
      "variant": "medium",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openrouter/nemotron-3-ultra-550b-a55b:free",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "openrouter/north-mini-code:free",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "compaction": {
      "mode": "primary",
      "model": "openrouter/nemotron-3-ultra-550b-a55b:free",
      "variant": "high"
    }
  }
}
